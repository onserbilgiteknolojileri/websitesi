        {
          "alias": false,
          "_styles": {
            "padding-top": "(@paddingTop * 1rem)",
            "padding-bottom": "(@paddingBottom * 1rem)",
            "& when (@bg-type = 'color')": {
              "background-color": "@bg-value"
            },
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)"
            },
            ".mbr-fallback-image.disabled": {
              "display": "none"
            },
            ".mbr-fallback-image": {
              "display": "block",
              "background-size": "cover",
              "background-position": "center center",
              "width": "100%",
              "height": "100%",
              "position": "absolute",
              "top": "0",
              "& when (@bg-type = 'video')": {
                "background-image": "url(@fallBackImage)"
              }
            },
            ".title-wrapper": {
              "margin-bottom": "50px",
              "@media (max-width: 992px)": {
                "margin-bottom": "30px"
              },
              ".label-wrapper": {
                ".mbr-label": {
                  "display": "inline-block",
                  "padding": "4px 20px",
                  "margin-bottom": "20px",
                  "border": "1px solid @label"
                }
              },
              ".title-wrap": {
                ".mbr-section-title": {
                  "width": "60%",
                  "display": "inline-block",
                  "margin-bottom": "0",
                  "@media (max-width: 992px)": {
                    "width": "100%"
                  }
                }
              }
            },
            ".items-wrapper": {
              "margin": "0 -15px",
              "justify-content": "center",
              ".item": {
                "padding": "0 15px"
              }
            },
            ".item": {
              "margin-bottom": "30px",
              "@media (max-width: 992px)": {
                "margin-bottom": "15px"
              },
              ".item-wrapper": {
                "position": "relative",
                "height": "100%",
                "padding": "40px",
                "background-color": "@cardBg",
                "overflow": "hidden",
                "will-change": "transform",
                "animation": "none !important",
                "@media (max-width: 992px)": {
                  "padding": "30px"
                },
                "&:hover, &:focus": {
                  "&::before": {
                    "width": "1000px",
                    "height": "1000px"
                  },
                  ".icon-card .mbr-iconfont": {
                    "background-color": "@activeBg",
                    "color": "@activeColor"
                  },
                  ".item-content": {
                    ".card-title": {
                      "color": "@activeColor"
                    },
                    ".card-desc": {
                      "color": "@activeColor"
                    }
                  },
                  ".item-img": {
                    "img": {
                      "bottom": "-30px"
                    }
                  }
                },
                "& when not (@showIcon)": {
                  "& when (@isRoundedImages)": {
                    "border-radius": "30px !important"
                  }
                },
                "& when (@bg-type = 'image')": {
                  "& when (@isRoundedImages)": {
                    "border-radius": "30px !important"
                  }
                },
                "&::before": {
                  "content": "''",
                  "position": "absolute",
                  "top": "0",
                  "right": "0",
                  "width": "0",
                  "height": "0",
                  "border-radius": "0 0 0 100% !important",
                  "background-color": "@activeBg",
                  "transition": "all 0.6s ease-in-out",
                  "pointer-events": "none"
                },
                ".icon-card": {
                  "position": "absolute",
                  "right": "0",
                  "top": "0",
                  "width": "60px",
                  "height": "60px",
                  "padding": "0 0 10px 10px",
                  "background-color": "@bg-value",
                  "border-radius": "0 0 0 30px",
                  "z-index": "2",
                  ".mbr-iconfont": {
                    "position": "relative",
                    "display": "inline-flex",
                    "align-items": "center",
                    "justify-content": "center",
                    "width": "50px",
                    "height": "50px",
                    "min-width": "50px",
                    "font-size": "18px",
                    "background-color": "@iconBg_1",
                    "color": "@icon",
                    "border-radius": "100%",
                    "transition": "all .3s ease",
                    "z-index": "5"
                  },
                  "&::before": {
                    "content": "''",
                    "position": "absolute",
                    "top": "0",
                    "left": "-20px",
                    "width": "20px",
                    "height": "20px",
                    "background-color": "transparent",
                    "border-top-right-radius": "30px",
                    "box-shadow": "10px -10px 0 10px @bg-value"
                  },
                  "&::after": {
                    "content": "''",
                    "position": "absolute",
                    "top": "60px",
                    "right": "0",
                    "width": "20px",
                    "height": "20px",
                    "background-color": "transparent",
                    "border-top-right-radius": "30px",
                    "box-shadow": "10px -10px 0 10px @bg-value"
                  }
                },
                ".item-content": {
                  "position": "relative",
                  "z-index": "1",
                  "margin-bottom": "50px",
                  "padding-right": "30px",
                  ".card-title": {
                    "margin-bottom": "20px",
                    "transition": "all .3s ease"
                  },
                  ".card-desc": {
                    "margin-bottom": "0",
                    "transition": "all .3s ease"
                  }
                },
                ".item-img": {
                  "height": "200px",
                  "img": {
                    "position": "absolute",
                    "left": "-30px",
                    "bottom": "-40px",
                    "height": "280px",
                    "width": "80%",
                    "transition": "all .5s ease",
                    "object-fit": "cover",
                    "@media (max-width: 992px)": {
                      "width": "90%"
                    }
                  }
                },
                ".image_2": {
                  "img": {
                    "width": "60%",
                    "@media (max-width: 992px)": {
                      "width": "90%"
                    }
                  }
                }
              }
            },
            ".btn-wrapper": {
              "margin-top": "0",
              "margin-right": "15%"
            },
            ".mbr-label, .label-wrapper": {
              "color": "#000000",
              "text-align": "center"
            },
            ".mbr-section-title, .title-wrapper": {
              "color": "#000000",
              "text-align": "center"
            },
            ".card-title": {
              "color": "#000000"
            },
            ".card-desc": {
              "color": "#8a8a8a"
            }
          },
          "_name": "features04",
          "_sourceTheme": "shapem5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"features04 shapem5\" group=\"Features\" mbr-class=\"{\n    'mbr-fullscreen': fullScreen,\n    'mbr-parallax-background': bg.parallax}\">\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\">\n        <input type=\"range\" inline=\"\" title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"12\" step=\"1\" value=\"5\">\n        <input type=\"range\" inline=\"\" title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"12\" step=\"1\" value=\"5\">\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Label\" name=\"showLabel\" checked=\"\">\n        <input type=\"color\" title=\"Border Color\" value=\"#e4ed64\" name=\"label\" condition=\"showLabel\" selected=\"\">\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\" checked=\"\">\n        <header>Cards</header>\n        <input type=\"checkbox\" title=\"Card Title\" name=\"showCardTitle\" checked=\"\">\n        <input type=\"checkbox\" title=\"Card Description\" name=\"showDesc\" checked=\"\">\n        <input type=\"color\" title=\"Card BG\" value=\"#ffffff\" name=\"cardBg\" selected=\"\">\n        <input type=\"color\" title=\"Active BG\" value=\"#e4ed64\" name=\"activeBg\" selected=\"\">\n        <input type=\"color\" title=\"Active Color\" value=\"#000000\" name=\"activeColor\" selected=\"\">\n        <header condition=\"bg.type === 'color'\">Icon</header>\n        <input type=\"checkbox\" title=\"Icon\" name=\"showIcon\" checked=\"\" condition=\"bg.type === 'color'\">\n        <input type=\"color\" title=\"Icon Color\" value=\"#000000\" name=\"icon\" condition=\"showIcon &amp;&amp; bg.type === 'color'\" selected=\"\">\n        <input type=\"color\" title=\"Icon Bg\" value=\"#ffffff\" name=\"iconBg_1\" condition=\"showIcon &amp;&amp; bg.type === 'color'\" selected=\"\">\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax=\"\">\n            <input type=\"image\" title=\"Image\" value=\"@THEME_PATH@/components/_images/background1.jpg\">\n            <input type=\"color\" title=\"Color\" value=\"#f6f3ec\" selected=\"\">\n        </fieldset>\n        <header condition=\"bg.type === 'video'\">Fallback Image</header>\n        <input type=\"image\" title=\"Fallback Image\" value=\"@THEME_PATH@/components/_images/background1.jpg\" name=\"fallBackImage\" condition=\"bg.type === 'video'\">\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked=\"\">\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#000000\" condition=\"overlay &amp;&amp; bg.type !== 'color'\">\n        <input type=\"range\" inline=\"\" title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.5\" condition=\"overlay &amp;&amp; bg.type !== 'color'\">\n    </mbr-parameters>\n\n    <div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay &amp;&amp; bg.type !== 'color'\" opacity=\"{{overlayOpacity}}\" bg-color=\"{{overlayColor}}\"></div>\n\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n        <div class=\"row\">\n            <div class=\"col-12\">\n                <div class=\"title-wrapper\" mbr-if=\"showLabel || showTitle\">\n                    <div class=\"label-wrapper\">\n                        <p class=\"mbr-label mbr-fonts-style\" data-app-selector=\".mbr-label, .label-wrapper\" mbr-theme-style=\"display-4\" mbr-if=\"showLabel\">\n                            <b>Property Solutions</b>\n                        </p>\n                    </div>\n                    <div class=\"title-wrap\">\n                        <h2 class=\"mbr-section-title mbr-fonts-style\" data-app-selector=\".mbr-section-title, .title-wrap\" mbr-theme-style=\"display-2\" mbr-if=\"showTitle\">\n                            <b>Your Trusted Partner in Every Property Journey</b>\n                        </h2>\n                    </div>\n                </div>\n            </div>\n        </div>\n        <div class=\"row items-wrapper\">\n            <div class=\"col-12 col-lg-4 item features-image\">\n                <div class=\"item-wrapper item-icon\">\n                    <div class=\"icon-wrapper icon-card\" mbr-if=\"showIcon &amp;&amp; bg.type === 'color'\">\n                        <a href=\"#\"><span mbr-icon=\"\" class=\"mobi-mbri mobi-mbri-right mbr-iconfont\"></span></a>\n                    </div>\n                    <div class=\"item-content\">\n                        <h4 class=\"card-title mbr-fonts-style\" mbr-theme-style=\"display-5\" mbr-if=\"showCardTitle\" data-app-selector=\".card-title\">\n                            Property Sales\n                        </h4>\n                        <p class=\"card-desc mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showDesc\" data-app-selector=\".card-desc\">\n                            Assisting clients with buying.\n                        </p>\n                    </div>\n                    <div class=\"item-img\">\n                        <img src=\"@PROJECT_PATH@/assets/images/image17.jpg\" alt=\"Mobirise Website Builder\">\n                    </div>\n                </div>\n            </div>\n            <div class=\"col-12 col-lg-4 item features-image\">\n                <div class=\"item-wrapper item-icon\">\n                    <div class=\"icon-wrapper icon-card\" mbr-if=\"showIcon &amp;&amp; bg.type === 'color'\">\n                        <a href=\"#\"><span mbr-icon=\"\" class=\"mobi-mbri mobi-mbri-right mbr-iconfont\"></span></a>\n                    </div>\n                    <div class=\"item-content\">\n                        <h4 class=\"card-title mbr-fonts-style\" mbr-theme-style=\"display-5\" mbr-if=\"showCardTitle\" data-app-selector=\".card-title\">\n                            Management\n                        </h4>\n                        <p class=\"card-desc mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showDesc\" data-app-selector=\".card-desc\">\n                            Managing rental properties.\n                        </p>\n                    </div>\n                    <div class=\"item-img\">\n                        <img src=\"@PROJECT_PATH@/assets/images/image9.jpg\" alt=\"Mobirise Website Builder\">\n                    </div>\n                </div>\n            </div>\n            <div class=\"col-12 col-lg-4 item features-image\">\n                <div class=\"item-wrapper item-icon\">\n                    <div class=\"icon-wrapper icon-card\" mbr-if=\"showIcon &amp;&amp; bg.type === 'color'\">\n                        <a href=\"#\"><span mbr-icon=\"\" class=\"mobi-mbri mobi-mbri-right mbr-iconfont\"></span></a>\n                    </div>\n                    <div class=\"item-content\">\n                        <h4 class=\"card-title mbr-fonts-style\" mbr-theme-style=\"display-5\" mbr-if=\"showCardTitle\" data-app-selector=\".card-title\">\n                            Consulting\n                        </h4>\n                        <p class=\"card-desc mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showDesc\" data-app-selector=\".card-desc\">\n                            Offering expert advice.\n                        </p>\n                    </div>\n                    <div class=\"item-img\">\n                        <img src=\"@PROJECT_PATH@/assets/images/image4.jpg\" alt=\"Mobirise Website Builder\">\n                    </div>\n                </div>\n            </div>\n            <div class=\"col-12 col-lg-6 item features-image\">\n                <div class=\"item-wrapper item-icon\">\n                    <div class=\"icon-wrapper icon-card\" mbr-if=\"showIcon &amp;&amp; bg.type === 'color'\">\n                        <a href=\"#\"><span mbr-icon=\"\" class=\"mobi-mbri mobi-mbri-right mbr-iconfont\"></span></a>\n                    </div>\n                    <div class=\"item-content\">\n                        <h4 class=\"card-title mbr-fonts-style\" mbr-theme-style=\"display-5\" mbr-if=\"showCardTitle\" data-app-selector=\".card-title\">\n                            Rental Services\n                        </h4>\n                        <p class=\"card-desc mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showDesc\" data-app-selector=\".card-desc\">\n                            Matching tenants with suitable rental properties.\n                        </p>\n                    </div>\n                    <div class=\"item-img image_2\">\n                        <img src=\"@PROJECT_PATH@/assets/images/image6.jpg\" alt=\"Mobirise Website Builder\">\n                    </div>\n                </div>\n            </div>\n            <div class=\"col-12 col-lg-6 item features-image\">\n                <div class=\"item-wrapper item-icon\">\n                    <div class=\"icon-wrapper icon-card\" mbr-if=\"showIcon &amp;&amp; bg.type === 'color'\">\n                        <a href=\"#\"><span mbr-icon=\"\" class=\"mobi-mbri mobi-mbri-right mbr-iconfont\"></span></a>\n                    </div>\n                    <div class=\"item-content\">\n                        <h4 class=\"card-title mbr-fonts-style\" mbr-theme-style=\"display-5\" mbr-if=\"showCardTitle\" data-app-selector=\".card-title\">\n                            Valuation &amp; Appraisal\n                        </h4>\n                        <p class=\"card-desc mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showDesc\" data-app-selector=\".card-desc\">\n                            Providing accurate market value assessments for selling.\n                        </p>\n                    </div>\n                    <div class=\"item-img image_2\">\n                        <img src=\"@PROJECT_PATH@/assets/images/image10.jpg\" alt=\"Mobirise Website Builder\">\n                    </div>\n                </div>\n            </div>\n        </div>\n    </div>\n</section>\n",
