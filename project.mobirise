        {
          "alias": false,
          "_styles": {
            "padding-top": "(@paddingTop * 1rem)",
            "padding-bottom": "(@paddingBottom * 1rem)",
            "& when (@bg-type = 'color')": {
              "background-color": "@bg-value"
            },
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)"
            },
            ".mbr-fallback-image.disabled": {
              "display": "none"
            },
            ".mbr-fallback-image": {
              "display": "block",
              "background-size": "cover",
              "background-position": "center center",
              "width": "100%",
              "height": "100%",
              "position": "absolute",
              "top": "0",
              "& when (@bg-type = 'video')": {
                "background-image": "url(@fallBackImage)"
              }
            },
            ".title-wrapper": {
              "display": "flex",
              "margin-bottom": "50px",
              "@media (max-width: 992px)": {
                "display": "block",
                "margin-bottom": "30px"
              },
              ".label-wrapper": {
                "width": "35%",
                "@media (max-width: 992px)": {
                  "width": "100%"
                },
                ".mbr-label": {
                  "display": "inline-block",
                  "padding": "4px 20px",
                  "margin-bottom": "20px",
                  "border": "1px solid @label"
                }
              },
              ".mbr-section-title": {
                "width": "65%",
                "margin-bottom": "0",
                "@media (max-width: 992px)": {
                  "width": "100%"
                }
              }
            },
            ".panel-group": {
              ".card": {
                "position": "relative",
                "padding": "40px 0",
                "background-color": "transparent",
                "border-top": "1px solid @border",
                "border-radius": "0 !important",
                "@media (max-width: 992px)": {
                  "padding": "30px 0"
                },
                ".card-header": {
                  "background-color": "transparent",
                  "border": "none",
                  "border-radius": "0",
                  "padding": "0",
                  ".panel-title": {
                    "display": "flex",
                    "justify-content": "space-between",
                    "align-items": "center",
                    "width": "100%",
                    ".icon-wrap": {
                      "width": "35%",
                      "position": "relative",
                      "@media (max-width: 992px)": {
                        "width": "25%"
                      },
                      ".mbr-iconfont": {
                        "width": "50px",
                        "height": "50px",
                        "min-width": "50px",
                        "display": "inline-flex",
                        "align-items": "center",
                        "justify-content": "center",
                        "border-radius": "100%",
                        "margin-right": "10px",
                        "transition": "all .3s ease",
                        "font-size": "24px",
                        "background-color": "@iconBg_1",
                        "color": "@icon_1"
                      },
                      ".svg1": {
                        "position": "absolute",
                        "bottom": "0",
                        "left": "24px",
                        "transform": "rotate(180deg)",
                        "width": "26px",
                        "path": {
                          "transition": "all .3s ease",
                          "fill": "@iconBg_1"
                        }
                      }
                    },
                    ".panel-title-edit": {
                      "width": "65%",
                      "padding-right": "30px",
                      "margin-bottom": "0",
                      "@media (max-width: 992px)": {
                        "width": "70%"
                      },
                      "& when not (@showIcon_1)": {
                        "width": "100%",
                        "@media (max-width: 992px)": {
                          "width": "100%"
                        }
                      }
                    },
                    ".icon-wrapper": {
                      "position": "absolute",
                      "right": "0",
                      "width": "20px",
                      "height": "20px",
                      "min-width": "20px",
                      "display": "inline-flex",
                      "align-items": "center",
                      "justify-content": "center",
                      "transition": "all 0.3s ease-in-out",
                      ".mbr-iconfont": {
                        "font-size": "18px",
                        "transition": "all 0.3s ease-in-out",
                        "color": "@icon_2"
                      }
                    },
                    "&:hover": {
                      ".icon-wrap": {
                        ".mbr-iconfont": {
                          "background-color": "@activeBg",
                          "color": "@active"
                        },
                        ".svg1": {
                          "path": {
                            "fill": "@activeBg"
                          }
                        }
                      }
                    },
                    "&:not(.collapsed)": {
                      ".icon-wrapper": {
                        ".mbr-iconfont": {
                          "transform": "rotate(-180deg)"
                        }
                      },
                      ".icon-wrap": {
                        ".mbr-iconfont": {
                          "background-color": "@activeBg",
                          "color": "@active"
                        },
                        ".svg1": {
                          "path": {
                            "fill": "@activeBg"
                          }
                        }
                      }
                    }
                  }
                },
                ".panel-collapse": {
                  ".panel-body": {
                    "margin-top": "40px",
                    "margin-left": "35%",
                    "@media (max-width: 992px)": {
                      "margin-top": "20px",
                      "margin-left": "0"
                    },
                    "& when not (@showIcon_1)": {
                      "margin-left": "0"
                    },
                    ".panel-text": {
                      "display": "inline-flex",
                      "width": "60%",
                      "margin-bottom": "0",
                      "@media (max-width: 992px)": {
                        "width": "100%"
                      }
                    }
                  }
                }
              }
            },
            ".mbr-label": {
              "color": "#000000"
            },
            ".mbr-section-title": {
              "color": "#000000"
            },
            ".panel-title-edit": {
              "color": "#000000"
            },
            ".panel-text": {
              "color": "#8a8a8a"
            }
          },
          "_name": "list01",
          "_sourceTheme": "shapem5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"list01 shapem5\" group=\"List\" plugins=\"mbr-switch-arrow, mobirise-icons2\" mbr-class=\"{\n    'mbr-fullscreen': fullScreen,\n    'mbr-parallax-background': bg.parallax}\">\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\">\n        <input type=\"range\" inline=\"\" title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"12\" step=\"1\" value=\"5\">\n        <input type=\"range\" inline=\"\" title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"12\" step=\"1\" value=\"5\">\n        <input type=\"checkbox\" title=\"Reverse\" name=\"reverseContent\">\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Label\" name=\"showLabel\" checked=\"\">\n        <input type=\"color\" title=\"Border Color\" value=\"#e4ed64\" name=\"label\" condition=\"showLabel\" selected=\"\">\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\" checked=\"\">\n        <header>List</header>\n        <select title=\"Amount\" name=\"cardAmount\">\n            <option value=\"1\">1</option>\n            <option value=\"2\">2</option>\n            <option value=\"3\">3</option>\n            <option value=\"4\">4</option>\n            <option value=\"5\">5</option>\n            <option value=\"6\" selected=\"\">6</option>\n        </select>\n        <input type=\"checkbox\" title=\"Icon 1\" name=\"showIcon_1\" checked=\"\">\n        <input type=\"color\" title=\"Icon Color 1\" value=\"#000000\" name=\"icon_1\" condition=\"showIcon_1\" selected=\"\">\n        <input type=\"color\" title=\"Icon Bg 1\" value=\"#e4ed64\" name=\"iconBg_1\" condition=\"showIcon_1\" selected=\"\">\n        <input type=\"color\" title=\"Active Color\" value=\"#ffffff\" name=\"active\" condition=\"showIcon_1\" selected=\"\">\n        <input type=\"color\" title=\"Active Bg\" value=\"#000000\" name=\"activeBg\" condition=\"showIcon_1\" selected=\"\">\n        <input type=\"color\" title=\"Icon Color 2\" value=\"#000000\" name=\"icon_2\" selected=\"\">\n        <input type=\"color\" title=\"Border Color\" name=\"border\" value=\"#e0e0e0\" selected=\"\">\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax=\"\">\n            <input type=\"image\" title=\"Image\" value=\"@THEME_PATH@/components/_images/background1.jpg\">\n            <input type=\"color\" title=\"Color\" value=\"#ffffff\" selected=\"\">\n        </fieldset>\n        <header condition=\"bg.type === 'video'\">Fallback Image</header>\n        <input type=\"image\" title=\"Fallback Image\" value=\"@THEME_PATH@/components/_images/background1.jpg\" name=\"fallBackImage\" condition=\"bg.type === 'video'\">\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked=\"\">\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#000000\" condition=\"overlay &amp;&amp; bg.type !== 'color'\">\n        <input type=\"range\" inline=\"\" title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.5\" condition=\"overlay &amp;&amp; bg.type !== 'color'\">\n    </mbr-parameters>\n\n    <div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay &amp;&amp; bg.type !== 'color'\" opacity=\"{{overlayOpacity}}\" bg-color=\"{{overlayColor}}\"></div>\n\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n        <div class=\"row\">\n            <div class=\"col-12\">\n                <div class=\"title-wrapper\" mbr-if=\"showLabel || showTitle\" mbr-class=\"{'flex-row-reverse' : reverseContent}\">\n                    <div class=\"label-wrapper\">\n                        <p class=\"mbr-label mbr-fonts-style\" data-app-selector=\".mbr-label, .label-wrapper\" mbr-theme-style=\"display-4\" mbr-if=\"showLabel\">\n                            <b>Property Experts</b>\n                        </p>\n                    </div>\n                    <h2 class=\"mbr-section-title mbr-fonts-style\" data-app-selector=\".mbr-section-title\" mbr-theme-style=\"display-2\" mbr-if=\"showTitle\">\n                        <b>Turning Properties Into Possibilities</b>\n                    </h2>\n                </div>\n            </div>\n            <div class=\"col-12\">\n                <div id=\"bootstrap-accordion\" class=\"panel-group accordionStyles accordion\" role=\"tablist\" aria-multiselectable=\"true\">\n                    <div class=\"card\">\n                        <div class=\"card-header\" role=\"tab\" id=\"headingOne\">\n                            <a role=\"button\" class=\"panel-title collapsed\" data-toggle=\"collapse\" data-bs-toggle=\"collapse\" data-bs-toggle=\"collapse\" data-core=\"\" href=\"#collapse1\" aria-expanded=\"false\" aria-controls=\"collapse1\">\n                                <div class=\"icon-wrap\" mbr-if=\"showIcon_1\">\n                                    <span class=\"mobi-mbri mobi-mbri-question mbr-iconfont\"></span>\n                                    <svg class=\"svg1\" viewBox=\"0 0 100 100\">\n                                        <path d=\"m100,0H0v100C0,44.77,44.77,0,100,0Z\"></path>\n                                    </svg>\n                                </div>\n                                <h4 class=\"panel-title-edit mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".panel-title-edit\">\n                                    <b>What services does your real estate company offer?</b>\n                                </h4>\n                                <div class=\"icon-wrapper\">\n                                    <span class=\"sign mobi-mbri mobi-mbri-down mbr-iconfont\"></span>\n                                </div>\n                            </a>\n                        </div>\n                        <div id=\"collapse1\" class=\"panel-collapse noScroll collapse\" role=\"tabpanel\" aria-labelledby=\"headingOne\" data-parent=\"#accordion\" data-bs-parent=\"#accordion\" data-bs-parent=\"#accordion\">\n                            <div class=\"panel-body\">\n                                <p class=\"panel-text mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".panel-text\">\n                                    We provide full-spectrum real estate services including buying, selling, renting,\n                                    property management, and investment consulting for both residential and commercial\n                                    properties.\n                                </p>\n                            </div>\n                        </div>\n                    </div>\n                    <div class=\"card\" mbr-if=\"cardAmount > 1\">\n                        <div class=\"card-header\" role=\"tab\" id=\"headingTwo\">\n                            <a role=\"button\" class=\"panel-title collapsed\" data-toggle=\"collapse\" data-bs-toggle=\"collapse\" data-bs-toggle=\"collapse\" data-core=\"\" href=\"#collapse2\" aria-expanded=\"false\" aria-controls=\"collapse2\">\n                                <div class=\"icon-wrap\" mbr-if=\"showIcon_1\">\n                                    <span class=\"mobi-mbri mobi-mbri-question mbr-iconfont\"></span>\n                                    <svg class=\"svg1\" viewBox=\"0 0 100 100\">\n                                        <path d=\"m100,0H0v100C0,44.77,44.77,0,100,0Z\"></path>\n                                    </svg>\n                                </div>\n                                <h4 class=\"panel-title-edit mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".panel-title-edit\">\n                                    <b>How do you help first-time homebuyers?</b>\n                                </h4>\n                                <div class=\"icon-wrapper\">\n                                    <span class=\"sign mobi-mbri mobi-mbri-down mbr-iconfont\"></span>\n                                </div>\n                            </a>\n                        </div>\n                        <div id=\"collapse2\" class=\"panel-collapse noScroll collapse\" role=\"tabpanel\" aria-labelledby=\"headingTwo\" data-parent=\"#accordion\" data-bs-parent=\"#accordion\" data-bs-parent=\"#accordion\">\n                            <div class=\"panel-body\">\n                                <p class=\"panel-text mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".panel-text\">\n                                    We guide first-time buyers through every step — from mortgage pre-approval and\n                                    property search to negotiations and closing, ensuring a smooth and informed\n                                    experience.\n                                </p>\n                            </div>\n                        </div>\n                    </div>\n                    <div class=\"card\" mbr-if=\"cardAmount > 2\">\n                        <div class=\"card-header\" role=\"tab\" id=\"headingThree\">\n                            <a role=\"button\" class=\"panel-title collapsed\" data-toggle=\"collapse\" data-bs-toggle=\"collapse\" data-bs-toggle=\"collapse\" data-core=\"\" href=\"#collapse3\" aria-expanded=\"false\" aria-controls=\"collapse3\">\n                                <div class=\"icon-wrap\" mbr-if=\"showIcon_1\">\n                                    <span class=\"mobi-mbri mobi-mbri-question mbr-iconfont\"></span>\n                                    <svg class=\"svg1\" viewBox=\"0 0 100 100\">\n                                        <path d=\"m100,0H0v100C0,44.77,44.77,0,100,0Z\"></path>\n                                    </svg>\n                                </div>\n                                <h4 class=\"panel-title-edit mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".panel-title-edit\">\n                                    <b>What areas do you serve?</b>\n                                </h4>\n                                <div class=\"icon-wrapper\">\n                                    <span class=\"sign mobi-mbri mobi-mbri-down mbr-iconfont\"></span>\n                                </div>\n                            </a>\n                        </div>\n                        <div id=\"collapse3\" class=\"panel-collapse noScroll collapse\" role=\"tabpanel\" aria-labelledby=\"headingThree\" data-parent=\"#accordion\" data-bs-parent=\"#accordion\" data-bs-parent=\"#accordion\">\n                            <div class=\"panel-body\">\n                                <p class=\"panel-text mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".panel-text\">\n                                    We serve both urban and suburban areas across [insert regions or cities], with a\n                                    strong focus on high-demand neighborhoods and growing markets.\n                                </p>\n                            </div>\n                        </div>\n                    </div>\n                    <div class=\"card\" mbr-if=\"cardAmount > 3\">\n                        <div class=\"card-header\" role=\"tab\" id=\"headingFour\">\n                            <a role=\"button\" class=\"panel-title collapsed\" data-toggle=\"collapse\" data-bs-toggle=\"collapse\" data-bs-toggle=\"collapse\" data-core=\"\" href=\"#collapse4\" aria-expanded=\"false\" aria-controls=\"collapse4\">\n                                <div class=\"icon-wrap\" mbr-if=\"showIcon_1\">\n                                    <span class=\"mobi-mbri mobi-mbri-question mbr-iconfont\"></span>\n                                    <svg class=\"svg1\" viewBox=\"0 0 100 100\">\n                                        <path d=\"m100,0H0v100C0,44.77,44.77,0,100,0Z\"></path>\n                                    </svg>\n                                </div>\n                                <h4 class=\"panel-title-edit mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".panel-title-edit\">\n                                    <b>How do you determine property value?</b>\n                                </h4>\n                                <div class=\"icon-wrapper\">\n                                    <span class=\"sign mobi-mbri mobi-mbri-down mbr-iconfont\"></span>\n                                </div>\n                            </a>\n                        </div>\n                        <div id=\"collapse4\" class=\"panel-collapse noScroll collapse\" role=\"tabpanel\" aria-labelledby=\"headingFour\" data-parent=\"#accordion\" data-bs-parent=\"#accordion\" data-bs-parent=\"#accordion\">\n                            <div class=\"panel-body\">\n                                <p class=\"panel-text mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".panel-text\">\n                                    We use a combination of market analysis, neighborhood trends, and professional\n                                    appraisals to provide accurate, competitive pricing.\n                                </p>\n                            </div>\n                        </div>\n                    </div>\n                    <div class=\"card\" mbr-if=\"cardAmount > 4\">\n                        <div class=\"card-header\" role=\"tab\" id=\"headingFive\">\n                            <a role=\"button\" class=\"panel-title collapsed\" data-toggle=\"collapse\" data-bs-toggle=\"collapse\" data-bs-toggle=\"collapse\" data-core=\"\" href=\"#collapse5\" aria-expanded=\"false\" aria-controls=\"collapse5\">\n                                <div class=\"icon-wrap\" mbr-if=\"showIcon_1\">\n                                    <span class=\"mobi-mbri mobi-mbri-question mbr-iconfont\"></span>\n                                    <svg class=\"svg1\" viewBox=\"0 0 100 100\">\n                                        <path d=\"m100,0H0v100C0,44.77,44.77,0,100,0Z\"></path>\n                                    </svg>\n                                </div>\n                                <h4 class=\"panel-title-edit mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".panel-title-edit\">\n                                    <b>Can you help with property investment?</b>\n                                </h4>\n                                <div class=\"icon-wrapper\">\n                                    <span class=\"sign mobi-mbri mobi-mbri-down mbr-iconfont\"></span>\n                                </div>\n                            </a>\n                        </div>\n                        <div id=\"collapse5\" class=\"panel-collapse noScroll collapse\" role=\"tabpanel\" aria-labelledby=\"headingFive\" data-parent=\"#accordion\" data-bs-parent=\"#accordion\" data-bs-parent=\"#accordion\">\n                            <div class=\"panel-body\">\n                                <p class=\"panel-text mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".panel-text\">\n                                    Absolutely. We assist investors with market insights, ROI projections, and\n                                    identifying undervalued opportunities in residential and commercial real estate.\n                                </p>\n                            </div>\n                        </div>\n                    </div>\n                    <div class=\"card\" mbr-if=\"cardAmount > 5\">\n                        <div class=\"card-header\" role=\"tab\" id=\"headingSix\">\n                            <a role=\"button\" class=\"panel-title collapsed\" data-toggle=\"collapse\" data-bs-toggle=\"collapse\" data-bs-toggle=\"collapse\" data-core=\"\" href=\"#collapse6\" aria-expanded=\"false\" aria-controls=\"collapse6\">\n                                <div class=\"icon-wrap\" mbr-if=\"showIcon_1\">\n                                    <span class=\"mobi-mbri mobi-mbri-question mbr-iconfont\"></span>\n                                    <svg class=\"svg1\" viewBox=\"0 0 100 100\">\n                                        <path d=\"m100,0H0v100C0,44.77,44.77,0,100,0Z\"></path>\n                                    </svg>\n                                </div>\n                                <h4 class=\"panel-title-edit mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".panel-title-edit\">\n                                    <b>Why should I choose your company over others?</b>\n                                </h4>\n                                <div class=\"icon-wrapper\">\n                                    <span class=\"sign mobi-mbri mobi-mbri-down mbr-iconfont\"></span>\n                                </div>\n                            </a>\n                        </div>\n                        <div id=\"collapse6\" class=\"panel-collapse noScroll collapse\" role=\"tabpanel\" aria-labelledby=\"headingSix\" data-parent=\"#accordion\" data-bs-parent=\"#accordion\" data-bs-parent=\"#accordion\">\n                            <div class=\"panel-body\">\n                                <p class=\"panel-text mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".panel-text, .panel-body\">\n                                    We combine local expertise, a personalized approach, and a strong track record of\n                                    results. Our goal is not just transactions, but long-term client success.\n                                </p>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </div>\n</section>\n",
          "_cid": "uMqkt5xONH",
          "_anchor": "list01-c",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        },
        {
          "alias": false,
          "_styles": {
            "padding-top": "(@paddingTop * 1rem)",
            "padding-bottom": "(@paddingBottom * 1rem)",
            "& when (@bg-type = 'color')": {
              "background-color": "@bg-value"
            },
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)"
            },
            ".mbr-fallback-image.disabled": {
              "display": "none"
            },
            ".mbr-fallback-image": {
              "display": "block",
              "background-size": "cover",
              "background-position": "center center",
              "width": "100%",
              "height": "100%",
              "position": "absolute",
              "top": "0",
              "& when (@bg-type = 'video')": {
                "background-image": "url(@fallBackImage)"
              }
            },
            ".title-wrapper": {
              "margin-bottom": "50px",
              "@media (max-width: 992px)": {
                "margin-bottom": "30px"
              },
              ".label-wrapper": {
                ".mbr-label": {
                  "display": "inline-block",
                  "padding": "4px 20px",
                  "margin-bottom": "20px",
                  "border": "1px solid @label"
                }
              },
              ".title-wrap": {
                ".mbr-section-title": {
                  "width": "60%",
                  "display": "inline-block",
                  "margin-bottom": "0",
                  "@media (max-width: 992px)": {
                    "width": "100%"
                  }
                }
              }
            },
            ".items-wrapper": {
              "margin": "0 -15px",
              "justify-content": "center",
              ".item": {
                "padding": "0 15px"
              }
            },
            ".item": {
              "margin-bottom": "40px",
              "@media (max-width: 992px)": {
                "margin-bottom": "30px"
              },
              ".item-wrapper": {
                "height": "100%",
                "&:hover, &:focus": {
                  ".image-wrapper": {
                    ".item-img": {
                      "img": {
                        "transform": "scale(1.2) translateX(30px)",
                        "@media (max-width: 992px)": {
                          "transform": "scale(1.2) translateX(15px)"
                        }
                      }
                    }
                  },
                  ".item-content": {
                    ".border-wrap::after": {
                      "width": "100%"
                    }
                  }
                },
                ".image-wrapper": {
                  "position": "relative",
                  "margin-bottom": "30px",
                  "@media (max-width: 992px)": {
                    "margin-bottom": "20px"
                  },
                  ".label-wrap": {
                    "position": "absolute",
                    "top": "0",
                    "left": "0",
                    "width": "100%",
                    "padding": "40px",
                    "z-index": "1",
                    "@media (max-width: 992px)": {
                      "padding": "30px 15px"
                    },
                    ".card-label": {
                      "display": "inline-block",
                      "padding": "4px 20px",
                      "margin-bottom": "15px",
                      "background-color": "@labelBg",
                      "border": "1px solid @labelBg"
                    }
                  },
                  ".item-img": {
                    "overflow": "hidden",
                    "img": {
                      "height": "500px",
                      "width": "100%",
                      "transition": "all .5s ease",
                      "object-fit": "cover",
                      "transform": "scale(1.2)",
                      "@media (max-width: 992px)": {
                        "height": "300px"
                      }
                    }
                  }
                },
                ".item-content": {
                  ".card-price": {
                    "margin-bottom": "20px"
                  },
                  ".card-title": {
                    "margin-bottom": "20px",
                    "transition": "all .3s ease"
                  },
                  ".border-wrap": {
                    "position": "relative",
                    "margin-bottom": "20px",
                    "width": "100%",
                    "height": "1px",
                    "transition": "all .3s ease",
                    "&::before": {
                      "content": "''",
                      "position": "absolute",
                      "top": "0",
                      "right": "0",
                      "width": "100%",
                      "height": "1px",
                      "background-color": "@border"
                    },
                    "&::after": {
                      "content": "''",
                      "position": "absolute",
                      "top": "0",
                      "left": "0",
                      "width": "0",
                      "height": "1px",
                      "background-color": "@activeColor",
                      "transition": "all .5s ease"
                    }
                  },
                  ".card-desc": {
                    "margin-bottom": "0",
                    "transition": "all .3s ease"
                  },
                  ".mbr-section-btn": {
                    "margin-top": "20px",
                    ".btn": {
                      "margin-bottom": "0"
                    }
                  }
                }
              }
            },
            ".mbr-label, .label-wrapper": {
              "color": "#000000"
            },
            ".mbr-section-title, .title-wrapper": {
              "color": "#000000"
            },
            ".card-label": {
              "color": "#000000"
            },
            ".card-price": {
              "color": "#000000"
            },
            ".card-title": {
              "color": "#000000"
            },
            ".card-desc": {
              "color": "#8a8a8a"
            }
          },
          "_name": "pricing01",
          "_sourceTheme": "shapem5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"pricing01 shapem5\" group=\"Pricing\" mbr-class=\"{\n    'mbr-fullscreen': fullScreen,\n    'mbr-parallax-background': bg.parallax}\">\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\">\n        <input type=\"range\" inline=\"\" title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"12\" step=\"1\" value=\"5\">\n        <input type=\"range\" inline=\"\" title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"12\" step=\"1\" value=\"5\">\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Label\" name=\"showLabel\" checked=\"\">\n        <input type=\"color\" title=\"Border Color\" value=\"#e4ed64\" name=\"label\" condition=\"showLabel\" selected=\"\">\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\" checked=\"\">\n        <header>Cards</header>\n        <input type=\"checkbox\" title=\"Card Label\" name=\"showCardLabel\" checked=\"\">\n        <input type=\"color\" title=\"Label BG\" value=\"#e4ed64\" name=\"labelBg\" condition=\"showCardLabel\" selected=\"\">\n        <input type=\"checkbox\" title=\"Card Price\" name=\"showPrice\" checked=\"\">\n        <input type=\"checkbox\" title=\"Card Title\" name=\"showCardTitle\" checked=\"\">\n        <input type=\"checkbox\" title=\"Card Description\" name=\"showDesc\" checked=\"\">\n        <input type=\"checkbox\" title=\"Card Buttons\" name=\"showButtons\" checked=\"\">\n        <input type=\"color\" title=\"Border Color\" value=\"#e0e0e0\" name=\"border\" selected=\"\">\n        <input type=\"color\" title=\"Card BG\" value=\"#e4ed64\" name=\"CardBg\" selected=\"\">\n        <input type=\"color\" title=\"Active Color\" value=\"#000000\" name=\"activeColor\" selected=\"\">\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax=\"\">\n            <input type=\"image\" title=\"Image\" value=\"@THEME_PATH@/components/_images/background1.jpg\">\n            <input type=\"color\" title=\"Color\" value=\"#f6f3ec\" selected=\"\">\n        </fieldset>\n        <header condition=\"bg.type === 'video'\">Fallback Image</header>\n        <input type=\"image\" title=\"Fallback Image\" value=\"@THEME_PATH@/components/_images/background1.jpg\" name=\"fallBackImage\" condition=\"bg.type === 'video'\">\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked=\"\">\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#000000\" condition=\"overlay &amp;&amp; bg.type !== 'color'\">\n        <input type=\"range\" inline=\"\" title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.5\" condition=\"overlay &amp;&amp; bg.type !== 'color'\">\n    </mbr-parameters>\n\n    <div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay &amp;&amp; bg.type !== 'color'\" opacity=\"{{overlayOpacity}}\" bg-color=\"{{overlayColor}}\"></div>\n\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n        <div class=\"row\">\n            <div class=\"col-12\">\n                <div class=\"title-wrapper\" mbr-if=\"showLabel || showTitle\">\n                    <div class=\"label-wrapper\">\n                        <p class=\"mbr-label mbr-fonts-style\" data-app-selector=\".mbr-label, .label-wrapper\" mbr-theme-style=\"display-4\" mbr-if=\"showLabel\">\n                            <b>Featured Listings</b>\n                        </p>\n                    </div>\n                    <div class=\"title-wrap\">\n                        <h2 class=\"mbr-section-title mbr-fonts-style\" data-app-selector=\".mbr-section-title, .title-wrap\" mbr-theme-style=\"display-2\" mbr-if=\"showTitle\">\n                            <b>Invest in Living, Grow in Value</b>\n                        </h2>\n                    </div>\n                </div>\n            </div>\n        </div>\n        <div class=\"row items-wrapper\">\n            <div class=\"col-12 col-lg-4 item features-image\">\n                <div class=\"item-wrapper item-icon\">\n                    <div class=\"image-wrapper\">\n                        <div class=\"label-wrap\">\n                            <p class=\"card-label mbr-fonts-style\" data-app-selector=\".card-label, .label-wrap\" mbr-theme-style=\"display-4\" mbr-if=\"showCardLabel\">\n                                <b>Our Product</b>\n                            </p>\n                        </div>\n                        <div class=\"item-img\">\n                            <img src=\"@PROJECT_PATH@/assets/images/image5.jpg\" alt=\"Mobirise Website Builder\">\n                        </div>\n                    </div>\n                    <div class=\"item-content\">\n                        <p class=\"card-price mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showPrice\" data-app-selector=\".card-price\">\n                            <b>$950,000</b>\n                        </p>\n                        <h4 class=\"card-title mbr-fonts-style\" mbr-theme-style=\"display-5\" mbr-if=\"showCardTitle\" data-app-selector=\".card-title\">\n                            The Horizon Condo\n                        </h4>\n                        <div class=\"border-wrap\"></div>\n                        <p class=\"card-desc mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showDesc\" data-app-selector=\".card-desc\">\n                            Ideal for urban professionals or investors looking for long-term value.\n                        </p>\n                        <div class=\"mbr-section-btn\" mbr-if=\"showButtons\" data-toolbar=\"-mbrBtnMove,-mbrBtnAdd\" mbr-buttons=\"\" mbr-theme-style=\"display-4\">\n                            <a href=\"\" class=\"btn item-btn btn-primary\" data-app-placeholder=\"Type Text\">\n                                <span class=\"mobi-mbri mobi-mbri-right mbr-iconfont mbr-iconfont-btn\"></span>\n                                Buy Now\n                            </a>\n                        </div>\n                    </div>\n                </div>\n            </div>\n            <div class=\"col-12 col-lg-4 item features-image\">\n                <div class=\"item-wrapper item-icon\">\n                    <div class=\"image-wrapper\">\n                        <div class=\"label-wrap\">\n                            <p class=\"card-label mbr-fonts-style\" data-app-selector=\".card-label, .label-wrap\" mbr-theme-style=\"display-4\" mbr-if=\"showCardLabel\">\n                                <b>Our Product</b>\n                            </p>\n                        </div>\n                        <div class=\"item-img\">\n                            <img src=\"@PROJECT_PATH@/assets/images/image6.jpg\" alt=\"Mobirise Website Builder\">\n                        </div>\n                    </div>\n                    <div class=\"item-content\">\n                        <p class=\"card-price mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showPrice\" data-app-selector=\".card-price\">\n                            <b>$645,000</b>\n                        </p>\n                        <h4 class=\"card-title mbr-fonts-style\" mbr-theme-style=\"display-5\" mbr-if=\"showCardTitle\" data-app-selector=\".card-title\">\n                            Family Home\n                        </h4>\n                        <div class=\"border-wrap\"></div>\n                        <p class=\"card-desc mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showDesc\" data-app-selector=\".card-desc\">\n                            A charming four-bedroom, three-bath residence in a quiet.\n                        </p>\n                        <div class=\"mbr-section-btn\" mbr-if=\"showButtons\" data-toolbar=\"-mbrBtnMove,-mbrBtnAdd\" mbr-buttons=\"\" mbr-theme-style=\"display-4\">\n                            <a href=\"\" class=\"btn item-btn btn-primary\" data-app-placeholder=\"Type Text\">\n                                <span class=\"mobi-mbri mobi-mbri-right mbr-iconfont mbr-iconfont-btn\"></span>\n                                Buy Now\n                            </a>\n                        </div>\n                    </div>\n                </div>\n            </div>\n            <div class=\"col-12 col-lg-4 item features-image\">\n                <div class=\"item-wrapper item-icon\">\n                    <div class=\"image-wrapper\">\n                        <div class=\"label-wrap\">\n                            <p class=\"card-label mbr-fonts-style\" data-app-selector=\".card-label, .label-wrap\" mbr-theme-style=\"display-4\" mbr-if=\"showCardLabel\">\n                                <b>Our Product</b>\n                            </p>\n                        </div>\n                        <div class=\"item-img\">\n                            <img src=\"@PROJECT_PATH@/assets/images/image11.jpg\" alt=\"Mobirise Website Builder\">\n                        </div>\n                    </div>\n                    <div class=\"item-content\">\n                        <p class=\"card-price mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showPrice\" data-app-selector=\".card-price\">\n                            <b>$1,350,000</b>\n                        </p>\n                        <h4 class=\"card-title mbr-fonts-style\" mbr-theme-style=\"display-5\" mbr-if=\"showCardTitle\" data-app-selector=\".card-title\">\n                            Ridgeview Retreat\n                        </h4>\n                        <div class=\"border-wrap\"></div>\n                        <p class=\"card-desc mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showDesc\" data-app-selector=\".card-desc\">\n                            Perfect for luxury buyers seeking privacy, design, and tranquility.\n                        </p>\n                        <div class=\"mbr-section-btn\" mbr-if=\"showButtons\" data-toolbar=\"-mbrBtnMove,-mbrBtnAdd\" mbr-buttons=\"\" mbr-theme-style=\"display-4\">\n                            <a href=\"\" class=\"btn item-btn btn-primary\" data-app-placeholder=\"Type Text\">\n                                <span class=\"mobi-mbri mobi-mbri-right mbr-iconfont mbr-iconfont-btn\"></span>\n                                Buy Now\n                            </a>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </div>\n</section>\n",
          "_cid": "uMqktlEYne",
          "_anchor": "pricing01-d",
          "_PHPplaceholders": [],
          "_JSplaceholders": [],
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        },
        {
          "alias": false,
          "_styles": {
            "padding-top": "(@paddingTop * 1rem)",
            "padding-bottom": "(@paddingBottom * 1rem)",
            "& when (@bg-type = \"color\")": {
              "background-color": "@bg-value",
              "& when (@gradientBg)": {
                "background-image": "linear-gradient(@gradientColor 50%, @bg-value)"
              }
            },
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)"
            },
            ".mbr-fallback-image.disabled": {
              "display": "none"
            },
            ".mbr-fallback-image": {
              "display": "block",
              "background-size": "cover",
              "background-position": "center center",
              "width": "100%",
              "height": "100%",
              "position": "absolute",
              "top": "0",
              "& when (@bg-type = 'video')": {
                "background-image": "url(@fallBackImage)"
              }
            },
            ".embla__slide": {
              "display": "flex",
              "justify-content": "center",
              "position": "relative",
              "min-width": "100%",
              "max-width": "100%",
              "@media (max-width: 767px)": {
                "min-width": "100%",
                "max-width": "100%"
              },
              ".slide-content": {
                "width": "100%",
                ".item-wrapper": {
                  ".item-content": {
                    ".item-text": {
                      "margin-bottom": "80px",
                      "@media (max-width: 992px)": {
                        "margin-bottom": "20px"
                      }
                    },
                    ".name-wrapper": {
                      ".item-name": {
                        "display": "inline-flex",
                        "margin-bottom": "10px",
                        "padding-bottom": "2px",
                        "border-bottom": "1px solid @border"
                      }
                    },
                    ".item-role": {
                      "margin-bottom": "0"
                    }
                  }
                }
              }
            },
            ".embla__button--next, .embla__button--prev": {
              "display": "flex"
            },
            ".embla__button": {
              "top": "50px",
              "width": "60px",
              "height": "60px",
              "font-size": "18px",
              "background-color": "@arrowsBg !important",
              "color": "@arrowsColor !important",
              "border": "none !important",
              "border-radius": "50%",
              "transition": "all 0.3s",
              "position": "absolute",
              "display": "flex",
              "justify-content": "center",
              "align-items": "center",
              "opacity": "1 !important",
              "& when not (@arrows)": {
                "display": "none"
              },
              "& when not (@arrowsMobile)": {
                "@media (max-width: 768px)": {
                  "display": "none"
                }
              },
              "@media (max-width: 992px)": {
                "top": "0"
              },
              "&:hover": {
                "background-color": "@activeBg !important",
                "color": "@activeColor !important"
              },
              "&.embla__button--prev": {
                "left": "0"
              },
              "&.embla__button--next": {
                "right": "0"
              }
            },
            ".embla": {
              "position": "relative",
              "width": "100%",
              "display": "flex",
              "justify-content": "center",
              "& when (@arrows)": {
                "@media (max-width: 992px)": {
                  "padding-top": "6rem"
                }
              }
            },
            ".embla__viewport": {
              "overflow": "hidden",
              "width": "70%",
              "margin-right": "1rem",
              "@media (max-width: 992px)": {
                "width": "100%"
              }
            },
            ".embla__viewport.is-draggable": {
              "cursor": "grab"
            },
            ".embla__viewport.is-dragging": {
              "cursor": "grabbing"
            },
            ".embla__container": {
              "display": "flex",
              "user-select": "none",
              "-webkit-touch-callout": "none",
              "-khtml-user-select": "none",
              "-webkit-tap-highlight-color": "transparent"
            },
            ".item-text": {
              "color": "#000000",
              "text-align": "center"
            },
            ".item-name, .name-wrapper": {
              "color": "#000000",
              "text-align": "center"
            },
            ".item-role": {
              "color": "#8a8a8a",
              "text-align": "center"
            }
          },
          "_name": "slider01",
          "_sourceTheme": "shapem5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"slider01 mbr-embla shapem5\" group=\"Sliders &amp; Galleries\" plugins=\"embla\" mbr-class=\"{\n    'mbr-fullscreen': fullScreen,\n    'mbr-parallax-background': bg.parallax}\">\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\">\n        <input type=\"range\" inline=\"\" title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"10\" step=\"1\" value=\"10\">\n        <input type=\"range\" inline=\"\" title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"10\" step=\"1\" value=\"10\">\n        <header>Carousel</header>\n        <input type=\"checkbox\" title=\"Autoplay\" name=\"autoplay\">\n        <input type=\"range\" title=\"Interval\" name=\"interval\" min=\"1\" max=\"10\" value=\"5\" step=\"1\" condition=\"autoplay\">\n        <input type=\"checkbox\" title=\"Loop\" name=\"loop\" checked=\"\">\n        <input type=\"checkbox\" title=\"Draggable\" name=\"draggable\" checked=\"\">\n        <input type=\"checkbox\" name=\"arrows\" title=\"Arrows\" checked=\"\">\n        <input type=\"checkbox\" name=\"arrowsMobile\" title=\"Mobile Arrows\" condition=\"arrows\" checked=\"\">\n        <input type=\"color\" title=\"Arrows Color\" value=\"#000000\" name=\"arrowsColor\" condition=\"arrows\" selected=\"\">\n        <input type=\"color\" title=\"Arrows BG\" value=\"#ffffff\" name=\"arrowsBg\" condition=\"arrows\" selected=\"\">\n        <input type=\"color\" title=\"Active Color\" value=\"#000000\" name=\"activeColor\" condition=\"arrows\" selected=\"\">\n        <input type=\"color\" title=\"Active BG\" value=\"#e4ed64\" name=\"activeBg\" condition=\"arrows\" selected=\"\">\n        <header>Cards</header>\n        <input type=\"checkbox\" title=\"Card Name\" name=\"showName\" checked=\"\">\n        <input type=\"color\" title=\"Border Color\" value=\"#e4ed64\" name=\"border\" condition=\"showName\" selected=\"\">\n        <input type=\"checkbox\" title=\"Card Role\" name=\"showRole\" checked=\"\">\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax=\"\" required=\"\">\n            <input type=\"image\" title=\"Image\" value=\"@THEME_PATH@/components/_images/background1.jpg\">\n            <input type=\"color\" title=\"Color\" value=\"#ffffff\" selected=\"\">\n        </fieldset>\n        <input type=\"checkbox\" title=\"Gradient Background\" name=\"gradientBg\" condition=\"bg.type=='color'\" checked=\"\">\n        <input type=\"color\" title=\"Gradient Color\" name=\"gradientColor\" value=\"#f6f3ec\" condition=\"gradientBg &amp;&amp; bg.type=='color'\">\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked=\"\">\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#ffffff\" condition=\"overlay &amp;&amp; bg.type == 'image'\">\n        <input type=\"range\" inline=\"\" title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.6\" condition=\"overlay &amp;&amp; bg.type == 'image'\">\n    </mbr-parameters>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay &amp;&amp; bg.type !== 'color'\"></div>\n\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n        <div class=\"row\">\n            <div class=\"col-12\">\n                <div class=\"embla\" data-loop=\"{{loop}}\" data-auto-play=\"{{autoplay}}\" data-auto-play-interval=\"{{interval}}\" data-draggable=\"{{draggable}}\" data-skip-snaps=\"true\" data-align=\"center\" data-contain-scroll=\"trimSnaps\">\n                    <div class=\"embla__viewport\">\n                        <div class=\"embla__container\">\n                            <div class=\"embla__slide slider-image item features-without-image\" mbr-style=\"{'margin-left': gap + 'px', 'margin-right': gap + 'px'}\">\n                                <div class=\"slide-content\">\n                                    <div class=\"item-wrapper\">\n                                        <div class=\"item-content\">\n                                            <p class=\"item-text mbr-fonts-style\" mbr-theme-style=\"display-5\" data-app-selector=\".item-text\">\n                                                \"Working with Real Estate Company was a seamless experience from\n                                                    start to finish. Their agents were incredibly knowledgeable and\n                                                    responsive, helping us find the perfect commercial space within\n                                                    budget.\"\n                                            </p>\n                                            <div class=\"name-wrapper\">\n                                                <p class=\"item-name mbr-fonts-style\" mbr-if=\"showName\" mbr-theme-style=\"display-7\" data-app-selector=\".item-name, .name-wrapper\">\n                                                    <b>Karen Mitchell</b>\n                                                </p>\n                                            </div>\n                                            <p class=\"item-role mbr-fonts-style\" mbr-if=\"showRole\" mbr-theme-style=\"display-4\" data-app-selector=\".item-role\">\n                                                Marketing Director\n                                            </p>\n                                        </div>\n                                    </div>\n                                </div>\n                            </div>\n                            <div class=\"embla__slide slider-image item features-without-image\" mbr-style=\"{'margin-left': gap + 'px', 'margin-right': gap + 'px'}\">\n                                <div class=\"slide-content\">\n                                    <div class=\"item-wrapper\">\n                                        <div class=\"item-content\">\n                                            <p class=\"item-text mbr-fonts-style\" mbr-theme-style=\"display-5\" data-app-selector=\".item-text\">\n                                                \"We've partnered with several real estate firms over the years, but\n                                                    none have matched the professionalism and efficiency of Real Estate\n                                                    Company.\"\n                                            </p>\n                                            <div class=\"name-wrapper\">\n                                                <p class=\"item-name mbr-fonts-style\" mbr-if=\"showName\" mbr-theme-style=\"display-7\" data-app-selector=\".item-name, .name-wrapper\">\n                                                    <b>James O’Reilly</b>\n                                                </p>\n                                            </div>\n                                            <p class=\"item-role mbr-fonts-style\" mbr-if=\"showRole\" mbr-theme-style=\"display-4\" data-app-selector=\".item-role\">\n                                                CEO\n                                            </p>\n                                        </div>\n                                    </div>\n                                </div>\n                            </div>\n                            <div class=\"embla__slide slider-image item features-without-image\" mbr-style=\"{'margin-left': gap + 'px', 'margin-right': gap + 'px'}\">\n                                <div class=\"slide-content\">\n                                    <div class=\"item-wrapper\">\n                                        <div class=\"item-content\">\n                                            <p class=\"item-text mbr-fonts-style\" mbr-theme-style=\"display-5\" data-app-selector=\".item-text\">\n                                                \"As a first-time property investor, I had many questions and\n                                                    concerns. The team at Real Estate Company guided me with patience and\n                                                    expertise every step of the way. \"\n                                            </p>\n                                            <div class=\"name-wrapper\">\n                                                <p class=\"item-name mbr-fonts-style\" mbr-if=\"showName\" mbr-theme-style=\"display-7\" data-app-selector=\".item-name, .name-wrapper\">\n                                                    <b>Dr. Elena Vasquez</b>\n                                                </p>\n                                            </div>\n                                            <p class=\"item-role mbr-fonts-style\" mbr-if=\"showRole\" mbr-theme-style=\"display-4\" data-app-selector=\".item-role\">\n                                                Founder\n                                            </p>\n                                        </div>\n                                    </div>\n                                </div>\n                            </div>\n                        </div>\n                    </div>\n                    <button class=\"embla__button embla__button--prev\">\n                        <span class=\"mobi-mbri mobi-mbri-left mbr-iconfont\" aria-hidden=\"true\"></span>\n                        <span class=\"sr-only visually-hidden visually-hidden visually-hidden visually-hidden\">Previous</span>\n                    </button>\n                    <button class=\"embla__button embla__button--next\">\n                        <span class=\"mobi-mbri mobi-mbri-right mbr-iconfont\" aria-hidden=\"true\"></span>\n                        <span class=\"sr-only visually-hidden visually-hidden visually-hidden visually-hidden\">Next</span>\n                    </button>\n                </div>\n            </div>\n        </div>\n    </div>\n</section>\n",
          "_cid": "uMqkpbjtjb",
          "_anchor": "slider01-7",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        },
        {
          "alias": false,
          "_styles": {
            "padding-top": "(@paddingTop * 1rem)",
            "padding-bottom": "(@paddingBottom * 1rem)",
            "& when (@bg-type = 'color')": {
              "background-color": "@bg-value"
            },
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)"
            },
            ".mbr-fallback-image.disabled": {
              "display": "none"
            },
            ".mbr-fallback-image": {
              "display": "block",
              "background-size": "cover",
              "background-position": "center center",
              "width": "100%",
              "height": "100%",
              "position": "absolute",
              "top": "0",
              "& when (@bg-type = 'video')": {
                "background-image": "url(@fallBackImage)"
              }
            },
            ".card-wrapper": {
              "position": "relative",
              "padding": "100px 180px",
              "will-change": "transform",
              "animation": "none !important",
              "@media (max-width: 1440px)": {
                "padding": "100px 40px"
              },
              "@media (max-width: 992px)": {
                "padding": "60px 15px 100px"
              },
              ".image-wrapper": {
                "img": {
                  "position": "absolute",
                  "top": "0",
                  "left": "0",
                  "width": "100%",
                  "height": "100%",
                  "object-fit": "cover"
                }
              },
              ".decor-wrap": {
                "position": "absolute",
                "bottom": "0",
                "left": "0",
                "width": "220px",
                "height": "60px",
                "background-color": "@bg-value",
                "border-top-right-radius": "30px",
                "z-index": "1",
                "@media (max-width: 992px)": {
                  "width": "120px"
                },
                "&::before": {
                  "content": "''",
                  "position": "absolute",
                  "top": "-20px",
                  "left": "0",
                  "width": "20px",
                  "height": "20px",
                  "background-color": "transparent",
                  "border-bottom-left-radius": "30px",
                  "box-shadow": "-10px 10px 0 10px @bg-value"
                },
                "&::after": {
                  "content": "''",
                  "position": "absolute",
                  "bottom": "0",
                  "right": "-20px",
                  "width": "20px",
                  "height": "20px",
                  "background-color": "transparent",
                  "border-bottom-left-radius": "30px",
                  "box-shadow": "-10px 10px 0 10px @bg-value"
                }
              },
              "& when (@showOver)": {
                "&::before": {
                  "content": "''",
                  "position": "absolute",
                  "top": "0",
                  "left": "0",
                  "width": "100%",
                  "height": "100%",
                  "background-color": "@overColor",
                  "opacity": "@overOpacity",
                  "border-bottom-right-radius": "30px",
                  "pointer-events": "none",
                  "z-index": "1"
                }
              },
              ".card-wrap": {
                "position": "relative",
                "z-index": "1",
                "background-color": "@containerBg",
                "display": "flex",
                "flex-direction": "column",
                "align-items": "center",
                "padding": "100px 0",
                "@media (max-width: 992px)": {
                  "padding": "30px 15px 100px"
                },
                ".label-wrapper": {
                  "width": "50%",
                  "@media (max-width: 992px)": {
                    "width": "100%"
                  },
                  ".mbr-label": {
                    "display": "inline-block",
                    "padding": "4px 20px",
                    "margin-bottom": "30px",
                    "border": "1px solid @label",
                    "@media (max-width: 992px)": {
                      "margin-bottom": "20px"
                    }
                  }
                },
                ".mbr-section-title": {
                  "margin-bottom": "40px",
                  "width": "50%",
                  "@media (max-width: 992px)": {
                    "margin-bottom": "30px",
                    "width": "100%"
                  }
                },
                ".form-wrap": {
                  "width": "50%",
                  "@media (max-width: 992px)": {
                    "width": "100%"
                  },
                  ".dragArea.row": {
                    "margin": "0 -15px",
                    ".form-group": {
                      "margin-bottom": "30px !important",
                      "padding": "0 15px",
                      ".form-control-label": {
                        "margin-bottom": "10px"
                      },
                      ".form-control": {
                        "background-color": "@inputBg",
                        "padding": "18px 30px",
                        "box-shadow": "none",
                        "border": "none !important",
                        "&::placeholder": {
                          "color": "@inputColor"
                        },
                        "&:hover, &:focus": {
                          "box-shadow": "none",
                          "border": "none !important"
                        }
                      },
                      "textarea": {
                        "@media (max-width: 992px)": {
                          "padding": "24px 16px"
                        }
                      },
                      ".form-check": {
                        "padding-left": "2.1em",
                        ".form-check-input": {
                          "background-color": "@inputColor",
                          "border-color": "@inputColor"
                        }
                      }
                    },
                    ".mbr-section-btn": {
                      "width": "100%",
                      "padding": "0 15px",
                      "margin": "0",
                      "@media (max-width: 992px)": {
                        "margin-top": "0"
                      },
                      ".btn": {
                        "margin-bottom": "0",
                        "margin-top": "0",
                        "margin-right": "0"
                      }
                    }
                  }
                }
              }
            },
            ".mbr-label, .label-wrapper": {
              "color": "#000000",
              "text-align": "center"
            },
            ".mbr-section-title": {
              "color": "#000000",
              "text-align": "center"
            },
            "label": {
              "color": "#8a8a8a"
            },
            ".mbr-section-btn": {
              "text-align": "right"
            }
          },
          "_name": "form01",
          "_sourceTheme": "shapem5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"form01 shapem5\" group=\"Form\" mbr-class=\"{\n    'mbr-fullscreen': fullScreen,\n    'mbr-parallax-background': bg.parallax}\">\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\" checked=\"\">\n        <input type=\"range\" inline=\"\" title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"12\" step=\"1\" value=\"5\">\n        <input type=\"range\" inline=\"\" title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"12\" step=\"1\" value=\"5\">\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Label\" name=\"showLabel\" checked=\"\">\n        <input type=\"color\" title=\"Border Color\" value=\"#e4ed64\" name=\"label\" condition=\"showLabel\" selected=\"\">\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\" checked=\"\">\n        <input type=\"color\" title=\"Container BG\" value=\"#ffffff\" name=\"containerBg\" selected=\"\">\n        <header>Image</header>\n        <input type=\"checkbox\" title=\"Image Overlay\" name=\"showOver\" checked=\"\">\n        <input type=\"color\" title=\"Overlay Color\" value=\"#000000\" name=\"overColor\" condition=\"showOver\" selected=\"\">\n        <input type=\"range\" inline=\"\" title=\"Overlay Opacity\" name=\"overOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.4\" condition=\"showOver\">\n        <input type=\"checkbox\" title=\"Image Decoration\" name=\"showDecor\" checked=\"\" condition=\"bg.type === 'color'\">\n        <header>Form</header>\n        <input type=\"color\" title=\"Input Color\" value=\"#8a8a8a\" name=\"inputColor\" selected=\"\">\n        <input type=\"color\" title=\"Input BG\" value=\"#f5f5f5\" name=\"inputBg\" selected=\"\">\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax=\"\">\n            <input type=\"image\" title=\"Image\" value=\"@THEME_PATH@/components/_images/background1.jpg\">\n            <input type=\"color\" title=\"Color\" value=\"#ffffff\" selected=\"\">\n        </fieldset>\n        <header condition=\"bg.type === 'video'\">Fallback Image</header>\n        <input type=\"image\" title=\"Fallback Image\" value=\"@THEME_PATH@/components/_images/background1.jpg\" name=\"fallBackImage\" condition=\"bg.type === 'video'\">\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked=\"\">\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#000000\" condition=\"overlay &amp;&amp; bg.type !== 'color'\">\n        <input type=\"range\" inline=\"\" title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.5\" condition=\"overlay &amp;&amp; bg.type !== 'color'\">\n    </mbr-parameters>\n\n    <div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay &amp;&amp; bg.type !== 'color'\" opacity=\"{{overlayOpacity}}\" bg-color=\"{{overlayColor}}\"></div>\n\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n        <div class=\"row\">\n            <div class=\"col-12\">\n                <div class=\"card-wrapper item-blur\">\n                    <div class=\"image-wrapper\">\n                        <img src=\"@PROJECT_PATH@/assets/images/background5.jpg\" alt=\"Mobirise Website Builder\">\n                    </div>\n                    <div class=\"decor-wrap\" mbr-if=\"showDecor\"></div>\n                    <div class=\"card-wrap\">\n                        <div class=\"label-wrapper\">\n                            <p class=\"mbr-label mbr-fonts-style\" data-app-selector=\".mbr-label, .label-wrapper\" mbr-theme-style=\"display-4\" mbr-if=\"showLabel\">\n                                <b>Start Here</b>\n                            </p>\n                        </div>\n                        <h2 class=\"mbr-section-title mbr-fonts-style\" data-app-selector=\".mbr-section-title, .mbr-section-btn\" mbr-theme-style=\"display-5\" mbr-if=\"showTitle\">\n                            Get in Touch With Our Real Estate Experts\n                        </h2>\n                        <div mbr-form=\"\" class=\"mbr-form form-wrap\">\n                            <form action=\"\" name=\"Form Name\" method=\"POST\" class=\"mbr-form form-with-styler\">\n                                <div class=\"row\">\n                                    <div hidden=\"hidden\" data-form-alert=\"\" class=\"alert alert-success col-12\"> Thanks\n                                        for filling out the form!\n                                    </div>\n                                    <div hidden=\"hidden\" data-form-alert-danger=\"\" class=\"alert alert-danger col-12\">\n                                        Oops...! some problem!\n                                    </div>\n                                </div>\n                                <div class=\"dragArea row\">\n                                    <div class=\"col-lg-6 col-md-12 col-sm-12 form-group mb-3\" data-for=\"name\">\n                                        <input type=\"text\" name=\"name\" placeholder=\"Your Name*\" data-form-field=\"name\" mbr-theme-style=\"display-7\" class=\"form-control\" value=\"\">\n                                    </div>\n                                    <div class=\"col-lg-6 col-md-12 col-sm-12 form-group mb-3\" data-for=\"email1\">\n                                        <input type=\"email\" name=\"email1\" placeholder=\"Your Email*\" data-form-field=\"email1\" mbr-theme-style=\"display-7\" class=\"form-control\" value=\"\">\n                                    </div>\n                                    <div data-for=\"phone\" class=\"col-lg-6 col-md-12 col-sm-12 form-group mb-3\" style=\"\">\n                                        <input type=\"text\" name=\"phone\" placeholder=\"Your Phone*\" data-form-field=\"phone\" mbr-theme-style=\"display-7\" class=\"form-control\" value=\"\">\n                                    </div>\n                                    <div data-for=\"text\" class=\"col-lg-6 col-md-12 col-sm-12 form-group mb-3\">\n                                        <input type=\"text\" name=\"text\" placeholder=\"Your Company\" data-form-field=\"text\" mbr-theme-style=\"display-7\" class=\"form-control\" value=\"\">\n                                    </div>\n                                    <div class=\"col-md-auto col mbr-section-btn\" mbr-buttons=\"true\" mbr-theme-style=\"display-4\" data-toolbar=\"-mbrBtnMove,-mbrLink,-mbrBtnRemove,-mbrBtnAdd\">\n                                        <a data-toolbar=\"-mbrBtnMove,-mbrLink,-mbrBtnRemove,-mbrBtnAdd\" type=\"submit\" class=\"btn btn-primary\">\n                                            <span class=\"mobi-mbri mobi-mbri-right mbr-iconfont mbr-iconfont-btn\"></span>\n                                            Send now\n                                        </a>\n                                    </div>\n                                </div>\n                            </form>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </div>\n</section>\n",
          "_cid": "uMqksniQKy",
          "_anchor": "form01-b",
