                ".item-content": {
                  "position": "relative",
                  "z-index": "1",
                  "background-color": "@cardBg",
                  "width": "48%",
                  "padding": "50px 60px",
                  "@media (max-width: 992px)": {
                    "padding": "30px 15px",
