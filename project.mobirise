          "_name": "map01",
          "_sourceTheme": "shapem5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"map01 shapem5\" group=\"Contact\" mbr-class=\"{\n    'mbr-fullscreen': fullScreen,\n    'mbr-parallax-background': bg.parallax}\">\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\">\n        <input type=\"range\" inline=\"\" title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"12\" step=\"1\" value=\"5\">\n        <input type=\"range\" inline=\"\" title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"12\" step=\"1\" value=\"5\">\n        <input type=\"checkbox\" title=\"Reverse\" name=\"reverseContent\">\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Label\" name=\"showLabel\" checked=\"\">\n        <input type=\"color\" title=\"Border Color\" value=\"#e4ed64\" name=\"label\" condition=\"showLabel\" selected=\"\">\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\" checked=\"\">\n        <input type=\"checkbox\" title=\"Description\" name=\"showDesc\" checked=\"\">\n        <input type=\"checkbox\" title=\"Buttons\" name=\"showButtons\" checked=\"\">\n        <header>Map</header>\n        <input type=\"map\" title=\"Map\" name=\"googleMap\">\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax=\"\">\n            <input type=\"image\" title=\"Image\" value=\"@THEME_PATH@/components/_images/background1.jpg\">\n            <input type=\"color\" title=\"Color\" value=\"#ffffff\" selected=\"\">\n        </fieldset>\n        <header condition=\"bg.type === 'video'\">Fallback Image</header>\n        <input type=\"image\" title=\"Fallback Image\" value=\"@THEME_PATH@/components/_images/background1.jpg\" name=\"fallBackImage\" condition=\"bg.type === 'video'\">\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked=\"\">\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#000000\" condition=\"overlay &amp;&amp; bg.type !== 'color'\">\n        <input type=\"range\" inline=\"\" title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.5\" condition=\"overlay &amp;&amp; bg.type !== 'color'\">\n    </mbr-parameters>\n\n    <div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay &amp;&amp; bg.type !== 'color'\" opacity=\"{{overlayOpacity}}\" bg-color=\"{{overlayColor}}\"></div>\n\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n        <div class=\"row\" mbr-class=\"{'flex-row-reverse' : reverseContent}\">\n            <div class=\"col-12 col-lg-5\">\n                <div class=\"content-wrapper\">\n                    <div class=\"label-wrapper\">\n                        <p class=\"mbr-label mbr-fonts-style\" data-app-selector=\".mbr-label, .label-wrapper\" mbr-theme-style=\"display-4\" mbr-if=\"showLabel\">\n                            <b>Location Matters</b>\n                        </p>\n                    </div>\n                    <h2 class=\"mbr-section-title mbr-fonts-style\" data-app-selector=\".mbr-section-title, .mbr-section-btn\" mbr-theme-style=\"display-2\" mbr-if=\"showTitle\">\n                        <b>Explore Your Next Address</b>\n                    </h2>\n                    <p class=\"mbr-desc mbr-fonts-style\" data-app-selector=\".mbr-desc\" mbr-theme-style=\"display-7\" mbr-if=\"showDesc\">\n                        Discover where lifestyle meets location.\n                    </p>\n                    <div mbr-buttons=\"\" mbr-theme-style=\"display-4\" class=\"mbr-section-btn\" mbr-if=\"showButtons\" data-toolbar=\"-mbrBtnMove\">\n                        <a class=\"btn btn-primary\" href=\"https://mobiri.se\" data-app-placeholder=\"Type Text\">\n                            <span class=\"mobi-mbri mobi-mbri-right mbr-iconfont mbr-iconfont-btn\"></span>\n                            Contact Now\n                        </a>\n                    </div>\n                </div>\n            </div>\n            <div class=\"col-12 col-lg-6\">\n                <div class=\"google-map\" mbr-map=\"googleMap\"></div>\n            </div>\n        </div>\n    </div>\n</section>\n",
          "_cid": "uMqkrRpUI2",
          "_anchor": "map01-a",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        },
        {
          "alias": false,
          "_styles": {
            "padding-top": "(@paddingTop * 1rem)",
            "padding-bottom": "(@paddingBottom * 1rem)",
            "& when (@bg-type = 'color')": {
              "background-color": "@bg-value"
            },
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)"
            },
            ".mbr-fallback-image.disabled": {
              "display": "none"
            },
            ".mbr-fallback-image": {
              "display": "block",
              "background-size": "cover",
              "background-position": "center center",
              "width": "100%",
              "height": "100%",
              "position": "absolute",
              "top": "0",
              "& when (@bg-type = 'video')": {
                "background-image": "url(@fallBackImage)"
              }
            },
            ".card-wrapper": {
              "position": "relative",
              "padding": "60px 180px 60px",
              "background-color": "@containerBg",
              "@media (max-width: 1440px)": {
                "padding": "60px 40px 60px"
              },
              "@media (max-width: 992px)": {
                "padding": "30px"
              },
              ".content-wrapper": {
                "display": "flex",
                "justify-content": "space-between",
                "margin-bottom": "40px",
                "padding-bottom": "60px",
                "@media (max-width: 992px)": {
                  "padding-bottom": "30px",
                  "margin-bottom": "30px",
                  "display": "block"
                },
                "& when (@showBorder)": {
                  "border-bottom": "1px solid @border"
                },
                ".content-wrap": {
                  "justify-content": "space-between",
                  "border-radius": "0 !important",
                  "width": "35%",
                  "@media (max-width: 1440px)": {
                    "width": "40%"
                  },
                  "@media (max-width: 992px)": {
                    "width": "100%",
                    "margin-bottom": "30px"
                  },
                  "& when (@showBorder)": {
                    "padding-right": "40px",
                    "border-right": "1px solid @border",
                    "@media (max-width: 992px)": {
                      "padding-right": "0",
                      "padding-bottom": "30px",
                      "border-right": "none",
                      "border-bottom": "1px solid @border"
                    }
                  },
                  "& when (@reverseContent)": {
                    "& when (@showBorder)": {
                      "padding-right": "0",
                      "border-right": "none",
                      "padding-left": "40px",
                      "border-left": "1px solid @border",
                      "@media (max-width: 992px)": {
                        "padding-left": "0",
                        "padding-bottom": "30px",
                        "border-left": "none",
                        "border-bottom": "1px solid @border"
                      }
                    }
                  },
                  ".mbr-section-title": {
                    "margin-bottom": "20px"
                  },
                  ".mbr-text": {
                    "margin-bottom": "0"
                  },
                  ".mbr-section-btn": {
                    "margin-top": "15px",
                    ".btn": {
                      "margin-bottom": "0"
                    }
                  }
                },
                ".nav-wrapper": {
                  "width": "35%",
                  "display": "flex",
                  "justify-content": "space-between",
                  "@media (max-width: 1440px)": {
                    "width": "40%"
                  },
                  "@media (max-width: 992px)": {
                    "width": "100%"
                  },
                  "& when (@showBorder)": {
                    "padding-left": "40px",
                    "border-left": "1px solid @border",
                    "@media (max-width: 992px)": {
                      "border-left": "none",
                      "padding-left": "0"
                    }
                  },
                  "& when (@reverseContent)": {
                    "& when (@showBorder)": {
                      "padding-left": "0",
                      "border-left": "none",
                      "padding-right": "40px",
                      "border-right": "1px solid @border",
                      "@media (max-width: 992px)": {
                        "border-right": "none",
                        "padding-right": "0"
                      }
                    }
                  },
                  ".nav-wrap": {
                    "width": "48%",
                    "@media (max-width: 992px)": {
                      "width": "100%"
                    },
                    ".list": {
                      "margin": "0",
                      "padding": "0",
                      "list-style-type": "none",
                      "display": "inline-flex",
                      "flex-direction": "column",
                      ".item-wrap": {
                        "display": "inline-block",
                        "position": "relative",
                        "margin-bottom": "20px",
                        "width": "fit-content",
                        "&::before": {
                          "content": "''",
                          "position": "absolute",
                          "bottom": "0",
                          "left": "0",
                          "width": "0",
                          "height": "1px",
                          "background-color": "@active",
                          "transition": "all .3s ease"
                        },
                        "&:hover, &:focus": {
                          "&::before": {
                            "width": "100%"
                          }
                        },
                        "&:last-child": {
                          "margin-bottom": "0"
                        }
                      }
                    }
                  }
                }
              },
              ".mbr-copy": {
                "margin-bottom": "0"
              }
            },
            ".mbr-section-title": {
              "color": "#000000"
            },
            ".mbr-text": {
              "color": "#8a8a8a"
            },
            ".list": {
              "color": "#000000"
            },
            ".mbr-copy": {
              "color": "#8a8a8a",
              "text-align": "center"
            }
          },
          "_name": "footer01",
          "_sourceTheme": "shapem5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"footer01 shapem5\" group=\"Footer\" global once=\"footers\" mbr-class=\"{\n    'mbr-fullscreen': fullScreen,\n    'mbr-parallax-background': bg.parallax}\">\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\" checked>\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"12\" step=\"1\" value=\"5\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"12\" step=\"1\" value=\"5\">\n        <input type=\"checkbox\" title=\"Reverse\" name=\"reverseContent\">\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\">\n        <input type=\"checkbox\" title=\"Text\" name=\"showText\">\n        <input type=\"checkbox\" title=\"Buttons\" name=\"showButtons\">\n        <input type=\"checkbox\" title=\"List 1\" name=\"showList_1\">\n        <input type=\"checkbox\" title=\"List 2\" name=\"showList_2\">\n        <input type=\"color\" title=\"Active Color\" value=\"#000000\" name=\"active\" condition=\"showList_1 || showList_2\" selected>\n        <input type=\"checkbox\" title=\"Border\" name=\"showBorder\">\n        <input type=\"color\" title=\"Border Color\" value=\"#e0e0e0\" name=\"border\" condition=\"showBorder\" selected>\n        <input type=\"checkbox\" title=\"Copyright\" name=\"showCopy\" checked>\n        <input type=\"color\" title=\"Container BG\" value=\"#ffffff\" name=\"containerBg\" selected>\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Image\" value=\"@PROJECT_PATH@/assets/images/background2.jpg\" parallax selected>\n            <input type=\"color\" title=\"Color\" value=\"#ffffff\">\n        </fieldset>\n        <header condition=\"bg.type === 'video'\">Fallback Image</header>\n        <input type=\"image\" title=\"Fallback Image\" value=\"@PROJECT_PATH@/assets/images/background2.jpg\" name=\"fallBackImage\" condition=\"bg.type === 'video'\">\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#000000\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.7\" condition=\"overlay && bg.type !== 'color'\">\n    </mbr-parameters>\n\n    <div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type !== 'color'\" opacity=\"{{overlayOpacity}}\" bg-color=\"{{overlayColor}}\"></div>\n\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n        <div class=\"row\">\n            <div class=\"col-12\">\n                <div class=\"card-wrapper\">\n                    <div class=\"content-wrapper\" mbr-class=\"{'flex-row-reverse' : reverseContent}\" mbr-if=\"showTitle || showText || showButtons || showList_1 || showList_2\">\n                        <div class=\"content-wrap card\" mbr-if=\"showTitle || showText || showButtons\">\n                            <h2 class=\"mbr-section-title mbr-fonts-style\" data-app-selector=\".mbr-section-title\" mbr-theme-style=\"display-5\" mbr-if=\"showTitle\">Real Estate Company</h2>\n                            <div class=\"text-wrapper\">\n                                <p class=\"mbr-text mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showText\" data-app-selector=\".mbr-text, .mbr-section-btn\">\n                                    Get in touch with our real estate experts.\n                                </p>\n                                <div mbr-buttons mbr-theme-style=\"display-4\" class=\"mbr-section-btn\" mbr-if=\"showButtons\" data-toolbar=\"-mbrBtnMove\">\n                                    <a class=\"btn btn-primary\" href=\"https://mobiri.se\" data-app-placeholder=\"Type Text\">\n                                        <span class=\"mobi-mbri mobi-mbri-right mbr-iconfont mbr-iconfont-btn\"></span>\n                                        Contact Now\n                                    </a>\n                                </div>\n                            </div>\n                        </div>\n                        <div class=\"nav-wrapper\" mbr-if=\"showList_1 || showList_2\">\n                            <div class=\"nav-wrap\" mbr-if=\"showList_1\">\n                                <ul class=\"list mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".list, .item-wrap\" data-multiline mbr-article>\n                                    <li class=\"item-wrap\"><b>About Us</b></li>\n                                    <li class=\"item-wrap\"><b>Team</b></li>\n                                    <li class=\"item-wrap\"><b>Clients</b></li>\n                                    <li class=\"item-wrap\"><b>Partners</b></li>\n                                    <li class=\"item-wrap\"><b>Services</b></li>\n                                    <li class=\"item-wrap\"><b>Solutions</b></li>\n                                </ul>\n                            </div>\n                            <div class=\"nav-wrap\" mbr-if=\"showList_2\">\n                                <ul class=\"list mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".list, .item-wrap\" data-multiline mbr-article>\n                                    <li class=\"item-wrap\"><b>Our Projects</b></li>\n                                    <li class=\"item-wrap\"><b>Our Blog</b></li>\n                                    <li class=\"item-wrap\"><b>Events</b></li>\n                                    <li class=\"item-wrap\"><b>Contacts</b></li>\n                                    <li class=\"item-wrap\"><b>Social</b></li>\n                                </ul>\n                            </div>\n                        </div>\n                    </div>\n                    <p class=\"mbr-copy mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showCopy\" data-app-selector=\".mbr-copy\">\n                        © Copyright 2030 - All Rights Reserved\n                    </p>\n                </div>\n            </div>\n        </div>\n    </div>\n</section>",
          "_cid": "uMqktWiqTb",
          "_anchor": "footer01-e",
          "_protectedParams": [],
          "_global": true,
          "_once": "footers",
          "_params": {}
        }
      ]
    }
  }
}