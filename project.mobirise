                  ".label-wrap": {
                    ".card-label": {
                      "display": "inline-block",
                      "padding": "4px 20px",
                      "margin-bottom": "15px",
                      "background-color": "@labelBg",
                      "border": "1px solid @labelBg"
                    }
                  },
                  ".card-title": {
                    "margin-bottom": "20px",
                    "transition": "all .3s ease",
                    "text-decoration": "underline",
                    "text-decoration-color": "transparent",
                    "padding-bottom": "20px",
                    "border-bottom": "1px solid @border",
                    "&:hover, &:focus": {
                      "text-decoration-color": "inherit"
                    }
                  },
                  ".card-text": {
                    "margin-bottom": "0",
                    "transition": "all .3s ease"
                  },
                  ".mbr-section-btn": {
                    "margin-top": "20px",
                    ".btn": {
                      "margin-bottom": "0"
                    }
                  }
                }
              }
            },
            ".mbr-label, .label-wrapper": {
              "color": "#000000",
